<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="range_marker_pool">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.01 0.01 0.01 1.0</ambient>
      <background>0.70 0.84 0.95 1.0</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>50 0 150 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 0.3 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="tank_fill">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.85 0.9 1.0 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>30</range>
        <constant>0.6</constant>
        <linear>0.02</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>6.4 -15.0 9.5 0.0 0.45 1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <include>
      <uri>model://tank</uri>
      <pose>-6.42 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://water_surface</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- The descriptor-driven marker is spawned by ROS launch. The legacy
         tank_targets model is deliberately absent from this isolated scene. -->
  </world>
</sdf>
