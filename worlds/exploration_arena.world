<?xml version="1.0"?>
<sdf version="1.10">
  <world name="exploration_arena">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>

    <physics type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <light type="directional" name="sun">
      <pose>50 0 150 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 0.3 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <include><uri>model://water_surface</uri></include>
    <model name="exploration_wall">
      <pose>4 0 0.55 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 5.0 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 5.0 1.2</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.82 0.82 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="exploration_return_wall">
      <pose>2 2.5 0.35 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 0.5 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.5 0.8</size></box></geometry>
          <material>
            <ambient>0.62 0.66 0.70 1</ambient>
            <diffuse>0.72 0.76 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="exploration_south_breakwater">
      <pose>-2.5 -4.0 0.55 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7.0 0.5 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>7.0 0.5 1.2</size></box></geometry>
          <material>
            <ambient>0.66 0.68 0.70 1</ambient>
            <diffuse>0.76 0.78 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
