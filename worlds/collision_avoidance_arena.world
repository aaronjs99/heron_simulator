<?xml version="1.0"?>
<sdf version="1.10">
  <world name="collision_avoidance_arena">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>

    <physics type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <light type="directional" name="sun">
      <pose>50 0 150 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 0.3 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <include><uri>model://water_surface</uri></include>

    <!-- The campaign's direct start-goal chord crosses this exact cylinder. -->
    <model name="center_post">
      <pose>2.75 0 0.55 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.40</radius><length>1.50</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.40</radius><length>1.50</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.40 0.05 1</ambient>
            <diffuse>1.00 0.50 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Nonblocking structures keep the lidar odometry problem observable. -->
    <model name="north_reference_wall">
      <pose>2.5 5.0 0.55 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.0 0.4 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.0 0.4 1.2</size></box></geometry></visual>
      </link>
    </model>
    <model name="south_reference_wall">
      <pose>2.5 -5.0 0.55 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.0 0.4 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.0 0.4 1.2</size></box></geometry></visual>
      </link>
    </model>
    <model name="west_reference_wall">
      <pose>-3.5 0 0.55 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 10.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 10.0 1.2</size></box></geometry></visual>
      </link>
    </model>
    <model name="east_reference_wall">
      <pose>8.5 0 0.55 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 10.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 10.0 1.2</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
