<?xml version="1.0"?>
<sdf version="1.10">
  <world name="open_water_course">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>

    <physics type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor><real_time_update_rate>250</real_time_update_rate></physics>
    <gravity>0 0 -9.80665</gravity>
    <light type="directional" name="sun">
      <pose>50 0 150 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 0.3 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <include><uri>model://water_surface</uri></include>
    <!-- The 4 m diameter course is obstacle-free. All four walls are inside the
         declared 6 m mapping range at startup and provide LiDAR geometry to DLiO. -->
    <model name="west_wall"><static>true</static><pose>-5.75 0 0.7 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.5 12 1.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 12 1.4</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>5.75 0 0.7 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.5 12 1.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 12 1.4</size></box></geometry></visual></link></model>
    <model name="north_wall"><static>true</static><pose>0 5.75 0.7 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>12 0.5 1.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.5 1.4</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -5.75 0.7 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>12 0.5 1.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.5 1.4</size></box></geometry></visual></link></model>
  </world>
</sdf>
