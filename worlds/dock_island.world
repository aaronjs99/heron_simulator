<?xml version="1.0"?>
<sdf version="1.10">
  <world name="dock_island">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>

    <physics type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor><real_time_update_rate>250</real_time_update_rate></physics>
    <gravity>0 0 -9.80665</gravity>
    <light type="directional" name="sun">
      <pose>50 0 150 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 0.3 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <include><uri>model://water_surface</uri></include>
    <!-- The boat starts 0.17 m beyond the centre pier, pointing away. -->
    <model name="west_quay"><static>true</static><pose>-8.25 0 0.75 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.5 14 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 14 1.5</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>8.25 0 0.75 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.5 14 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 14 1.5</size></box></geometry></visual></link></model>
    <model name="north_wall"><static>true</static><pose>0 7.25 0.75 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>17 0.5 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>17 0.5 1.5</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -7.25 0.75 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>17 0.5 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>17 0.5 1.5</size></box></geometry></visual></link></model>
    <model name="centre_pier"><static>true</static><pose>-7.125 0 0.45 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>2.25 1.0 0.9</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.25 1.0 0.9</size></box></geometry></visual></link></model>
    <model name="north_pier"><static>true</static><pose>-6.75 4.0 0.45 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>3.0 0.9 0.9</size></box></geometry></collision><visual name="visual"><geometry><box><size>3.0 0.9 0.9</size></box></geometry></visual></link></model>
    <model name="south_pier"><static>true</static><pose>-6.75 -4.0 0.45 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>3.0 0.9 0.9</size></box></geometry></collision><visual name="visual"><geometry><box><size>3.0 0.9 0.9</size></box></geometry></visual></link></model>
    <!-- The island blocks the straight eastbound line while leaving broad water on every side. -->
    <model name="central_island"><static>true</static><pose>0.75 0 0.65 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>2.2 2.4 1.3</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.2 2.4 1.3</size></box></geometry></visual></link></model>
  </world>
</sdf>
