<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====================================================================== -->
  <!-- IG Handle simulator sensor add-on. All sensor frame and mount poses
       come from the launch-selected sensor-frame YAML through
       ig_handle/scripts/frames/export.py and HERON_* environment variables. -->
  <!-- ====================================================================== -->

  <!-- Material Definitions -->
  <material name="sensor_black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="sensor_blue">
    <color rgba="0.2 0.4 0.8 1"/>
  </material>
  <material name="sensor_yellow">
    <color rgba="0.9 0.8 0.1 1"/>
  </material>

  <!-- ====================================================================== -->
  <!-- Lidar H (Horizontal) -->
  <!-- Sensor origins come from the launch-selected sensor-frame YAML
       via HERON_* environment variables exported by ig_handle_benchmark. -->
  <!-- Horizontal VLP-16: +X starboard, +Y bow, +Z up. -->
  <!-- Velodyne VLP-16 model: 16 channels, 360 degree sweep, 10 Hz at 600 RPM. -->
  <!-- ====================================================================== -->
  <!-- Mount pole for Lidar H -->
  <link name="lidar_h_mount">
    <visual>
      <geometry><cylinder radius="0.03" length="0.22"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="lidar_h_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_h_mount"/>
    <origin xyz="$(optenv HERON_LIDAR_H_MOUNT_XYZ)" rpy="$(optenv HERON_LIDAR_H_MOUNT_RPY)"/>
  </joint>

  <link name="lidar_h_link">
    <visual>
      <geometry><cylinder radius="0.05086" length="0.07238"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="lidar_h_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_h_link"/>
    <origin xyz="$(optenv HERON_LIDAR_H_XYZ)" rpy="$(optenv HERON_LIDAR_H_RPY)"/>
  </joint>

  <gazebo reference="lidar_h_link">
    <sensor type="gpu_lidar" name="lidar_h_sensor">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>$(optenv HERON_SIM_LIDAR_UPDATE_RATE_HZ 10)</update_rate>
      <topic>/sensors/lidar/hori</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>$(optenv HERON_SIM_LIDAR_HORIZONTAL_SAMPLES 1800)</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>$(optenv HERON_SIM_LIDAR_VERTICAL_SAMPLES 16)</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle> <!-- -15 deg -->
            <max_angle>0.261799</max_angle>  <!-- +15 deg -->
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>200.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ====================================================================== -->
  <!-- Lidar V (Vertical) -->
  <!-- Vertical VLP-16: +X starboard, +Y up, +Z aft. Runtime TF ownership is
       lidar_h_link -> lidar_v_link; the mount visual remains in base_link. -->
  <!-- ====================================================================== -->
  <!-- Mount pole for Lidar V -->
  <link name="lidar_v_mount">
    <visual>
      <geometry><cylinder radius="0.025" length="0.14"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="lidar_v_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_v_mount"/>
    <origin xyz="$(optenv HERON_LIDAR_V_MOUNT_XYZ)" rpy="$(optenv HERON_LIDAR_V_MOUNT_RPY)"/>
  </joint>

  <link name="lidar_v_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.07"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="lidar_v_joint" type="fixed">
    <parent link="lidar_h_link"/>
    <child link="lidar_v_link"/>
    <origin xyz="$(optenv HERON_LIDAR_V_XYZ)" rpy="$(optenv HERON_LIDAR_V_RPY)"/>
  </joint>

  <!-- Keep the physical link and TF in the robot model, but omit the Gazebo
       ray sensor and publisher when inventory sensor 3 is disabled. -->
  <xacro:if value="$(optenv HERON_LIDAR_V 1)">
  <gazebo reference="lidar_v_link">
    <sensor type="gpu_lidar" name="lidar_v_sensor">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>$(optenv HERON_SIM_LIDAR_UPDATE_RATE_HZ 10)</update_rate>
      <topic>/sensors/lidar/vert</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>$(optenv HERON_SIM_LIDAR_HORIZONTAL_SAMPLES 1800)</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>$(optenv HERON_SIM_LIDAR_VERTICAL_SAMPLES 16)</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle> <!-- -15 deg -->
            <max_angle>0.261799</max_angle>  <!-- +15 deg -->
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>200.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  </xacro:if>

  <!-- ====================================================================== -->
  <!-- Sonar -->
  <!-- Imagenex DT100 profile model. Pose comes from sensor_frames.yaml. -->
  <!-- The acoustic +X axis is pitched down into ROS -Z. The ray fan models the -->
  <!-- 480-beam, 120 degree cross-track profile. The physical 3 degree along-track -->
  <!-- beam width is a footprint property, not extra profile beams, so Gazebo emits -->
  <!-- one profile slice per ping. -->
  <!-- ====================================================================== -->
  <link name="dt100_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.05"/></geometry>
      <material name="sensor_blue"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="dt100_joint" type="fixed">
    <parent link="base_link"/>
    <child link="dt100_link"/>
    <origin xyz="$(optenv HERON_DT100_XYZ)" rpy="$(optenv HERON_DT100_RPY)"/>
  </joint>

  <xacro:if value="$(optenv HERON_SIM_MULTIBEAM_ENABLED true)">
  <gazebo reference="dt100_link">
    <sensor type="gpu_lidar" name="dt100">
      <always_on>true</always_on>
      <topic>$(optenv HERON_SIM_SONAR_RAY_TOPIC /sim/sensors/sonar/echosounder/rays)</topic>
      <update_rate>20</update_rate>
      <lidar>
         <scan>
            <horizontal>
               <samples>480</samples>
               <resolution>1</resolution>
               <min_angle>-1.047198</min_angle>
               <!-- 480 documented 0.25-degree 83P beam centers: -60 to +59.75 deg. -->
               <max_angle>1.042834</max_angle>
            </horizontal>
            <vertical>
               <samples>1</samples>
               <resolution>1</resolution>
               <min_angle>0.0</min_angle>
               <max_angle>0.0</max_angle>
            </vertical>
         </scan>
         <range>
            <min>0.5</min>
            <max>100.0</max>
            <resolution>0.02</resolution>
         </range>
      </lidar>
    </sensor>
  </gazebo>
  </xacro:if>

  <link name="ping360_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.05"/></geometry>
      <material name="sensor_blue"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="ping360_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ping360_link"/>
    <origin xyz="$(optenv HERON_PING360_XYZ)" rpy="$(optenv HERON_PING360_RPY)"/>
  </joint>

  <xacro:if value="$(optenv HERON_SIM_PING360_ENABLED true)">
  <gazebo reference="ping360_link">
    <!-- Separate full-circle environment sampler for the canonical Ping360
         simulator. It does not fabricate vendor wire packets: the simulator
         publishes normalized profiles one mechanical angle at a time. -->
    <sensor type="gpu_lidar" name="ping360_environment">
      <always_on>true</always_on>
      <topic>$(optenv HERON_SIM_PING360_RAY_TOPIC /sim/sensors/sonar/imaging/rays)</topic>
      <update_rate>20</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>-3.141593</min_angle>
            <max_angle>3.125885</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.5</min>
          <max>100.0</max>
          <resolution>0.02</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  </xacro:if>

  <!-- ====================================================================== -->
  <!-- Camera Mount Pole -->
  <!-- ====================================================================== -->
  <link name="camera_mount">
    <visual>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount"/>
    <origin xyz="$(optenv HERON_CAMERA_MOUNT_XYZ)" rpy="$(optenv HERON_CAMERA_MOUNT_RPY)"/>
  </joint>

  <!-- Gazebo Harmonic's Ogre2 sensor renderer supports pinhole cameras only;
       lens distortion is deliberately kept out of SDF to avoid unsupported
       render passes and misleading camera outputs. -->
  <xacro:macro name="ig_handle_forge_camera"
               params="id xyz rpy optical_rpy topic_suffix camera_name">
    <link name="${id}">
      <visual>
        <geometry><box size="0.06 0.06 0.04"/></geometry>
        <material name="sensor_blue"/>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${id}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${id}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${id}_optical"/>
    <joint name="${id}_optical_joint" type="fixed">
      <parent link="${id}"/>
      <child link="${id}_optical"/>
      <origin xyz="0 0 0" rpy="${optical_rpy}"/>
    </joint>

    <gazebo reference="${id}">
      <sensor type="camera" name="camera_${id}_sensor">
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <topic>/sensors/camera/${topic_suffix}/image_raw</topic>
        <camera name="${camera_name}">
          <camera_info_topic>/sensors/camera/${topic_suffix}/camera_info</camera_info_topic>
          <horizontal_fov>1.60</horizontal_fov>
          <image>
            <width>640</width>
            <height>512</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ====================================================================== -->
  <!-- Forge camera stack -->
  <!-- F1/F2 face forward; F3/F4 face upward. F1/F4 are right/starboard mounts
       when looking from behind, and F2/F3 are left/port mounts. These frame
       names intentionally match the real Forge driver frame IDs and shared
       sensor YAML. -->
  <!-- ====================================================================== -->
  <xacro:if value="$(optenv HERON_CAMERA_F1 1)">
    <xacro:ig_handle_forge_camera id="F1"
                                  xyz="$(optenv HERON_CAMERA_F1_XYZ)"
                                  rpy="$(optenv HERON_CAMERA_F1_RPY)"
                                  optical_rpy="$(optenv HERON_CAMERA_FORWARD_OPTICAL_RPY)"
                                  topic_suffix="f1"
                                  camera_name="forward_starboard"/>
  </xacro:if>
  <xacro:if value="$(optenv HERON_CAMERA_F2 1)">
    <xacro:ig_handle_forge_camera id="F2"
                                  xyz="$(optenv HERON_CAMERA_F2_XYZ)"
                                  rpy="$(optenv HERON_CAMERA_F2_RPY)"
                                  optical_rpy="$(optenv HERON_CAMERA_FORWARD_OPTICAL_RPY)"
                                  topic_suffix="f2"
                                  camera_name="forward_port"/>
  </xacro:if>
  <xacro:if value="$(optenv HERON_CAMERA_F3 1)">
    <xacro:ig_handle_forge_camera id="F3"
                                  xyz="$(optenv HERON_CAMERA_F3_XYZ)"
                                  rpy="$(optenv HERON_CAMERA_F3_RPY)"
                                  optical_rpy="$(optenv HERON_CAMERA_UPWARD_OPTICAL_RPY)"
                                  topic_suffix="f3"
                                  camera_name="upward_port"/>
  </xacro:if>
  <xacro:if value="$(optenv HERON_CAMERA_F4 1)">
    <xacro:ig_handle_forge_camera id="F4"
                                  xyz="$(optenv HERON_CAMERA_F4_XYZ)"
                                  rpy="$(optenv HERON_CAMERA_F4_RPY)"
                                  optical_rpy="$(optenv HERON_CAMERA_UPWARD_OPTICAL_RPY)"
                                  topic_suffix="f4"
                                  camera_name="upward_starboard"/>
  </xacro:if>

  <!-- ====================================================================== -->
  <!-- IMU Visual (for debugging) -->
  <!-- IMU pose comes from the canonical sensor frame config through HERON_IMU_*.
       Encased MTi-30 AHRS device ID 0368xxxx: connector side is -X and exits
       aft, the unit is upside down, so +X is forward, +Y is starboard/right,
       and +Z points down toward the water. -->
  <!-- Note: imu_link is already defined in base Heron URDF, just add visual -->
  <!-- ====================================================================== -->
  <!-- Debug link marker - placed at approximate IMU location -->
  <link name="debug_extra_link">
    <visual>
      <geometry><box size="0.05 0.03 0.02"/></geometry>
      <material name="sensor_yellow"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="debug_extra_joint" type="fixed">
    <parent link="base_link"/>
    <child link="debug_extra_link"/>
    <origin xyz="$(optenv HERON_IMU_XYZ)" rpy="$(optenv HERON_IMU_RPY)"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="ig_handle_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/sensors/imu/data</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><stddev>0.005</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.005</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.005</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><stddev>0.005</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.005</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.005</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
