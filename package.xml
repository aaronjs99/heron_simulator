<?xml version="1.0"?>
<package format="3">
  <name>heron_simulator</name>
  <version>0.5.0</version>
  <description>
    Gazebo Harmonic simulation for the Heron USV hull, thruster bridge, and
    simulated sensor publishers. Based on heron_simulator by Clearpath Robotics.
  </description>

  <maintainer email="aaronjs@g.ucla.edu">Aaron John Sabu</maintainer>
  <author email="gstoppi@clearpathrobotics.com">Guy Stoppi (Clearpath Robotics)</author>
  <author email="yanma@clearpathrobotics.com">Yan Ma (Clearpath Robotics)</author>
  <author email="mpurvis@clearpathrobotics.com">Mike Purvis (Clearpath Robotics)</author>
  <license>BSD-3-Clause</license>
  <license>MIT</license>
  <url type="repository">https://github.com/aaronjs99/heron_simulator</url>
  <url type="bugtracker">https://github.com/aaronjs99/heron_simulator/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>ament_cmake_python</build_depend>
  <build_depend>gz_math_vendor</build_depend>
  <build_depend>gz_msgs_vendor</build_depend>
  <build_depend>gz_plugin_vendor</build_depend>
  <build_depend>gz_sim_vendor</build_depend>
  <build_depend>gz_transport_vendor</build_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>heron_description</exec_depend>
  <exec_depend>heron_msgs</exec_depend>
  <exec_depend>ig_handle</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mariner</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>oracle</exec_depend>
  <exec_depend>range_aid</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>xvfb</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"
                plugin_path="${prefix}/../../lib/heron_simulator"/>
  </export>
</package>